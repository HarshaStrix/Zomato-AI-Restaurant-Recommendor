{
    "version": 2,
    "builds": [
        {
            "src": "web/package.json",
            "use": "@vercel/next"
        },
        {
            "src": "api/index.py",
            "use": "@vercel/python",
            "config": {
                "runtime": "python3.10"
            }
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "api/index.py"
        },
        {
            "source": "/health",
            "destination": "api/index.py"
        },
        {
            "source": "/(.*)",
            "destination": "/web/$1"
        }
    ]
}